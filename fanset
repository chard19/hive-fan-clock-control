#!/usr/bin/python3
"""Configure the selected Cryptone case-fan controller, without restarting it."""
import argparse
import fcntl
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time

CONTROL_PATH = Path('/usr/local/sbin/cryptone-fan-control.py')
CONFIG_PATH = Path('/etc/cryptone-fan-control.json')
STATUS_PATH = Path('/run/cryptone-fan-control/status.json')
SERVICE = 'cryptone-fan-control.service'
ACK_TIMEOUT = 15
MAX_CONFIG_BYTES = 65536
MAX_STATUS_BYTES = 262144
FIELDS = ('target_c', 'min_pwm_percent', 'max_pwm_percent')


def load_control():
    spec = importlib.util.spec_from_file_location('cryptone_control', CONTROL_PATH)
    control = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(control)
    return control


def service_info(timeout=3):
    try:
        result = subprocess.run(['systemctl', 'show', SERVICE, '-p', 'ActiveState', '-p', 'MainPID'],
                                capture_output=True, text=True, timeout=timeout, check=False)
        if result.returncode == 0:
            fields = dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)
            return fields.get('ActiveState', 'unknown'), int(fields.get('MainPID', '0'))
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return 'unknown', 0


def read_status():
    try:
        with STATUS_PATH.open('rb') as stream:
            raw = stream.read(MAX_STATUS_BYTES + 1)
        if len(raw) > MAX_STATUS_BYTES:
            return {}
        status = json.loads(raw)
        return status if isinstance(status, dict) else {}
    except (OSError, ValueError, RecursionError):
        return {}


def fresh(status):
    stamp = status.get('updated_at')
    now = time.time()
    return type(stamp) in (int, float) and now - 15 <= stamp <= now


def confirms(status, cfg, digest):
    pwm = status.get('pwm_actual_percent')
    if (not fresh(status) or status.get('config_hash') != digest or
            status.get('applied_config') != cfg or status.get('config_error') or
            type(status.get('controller_pid')) is not int or
            type(pwm) not in (int, float) or not 0 <= pwm <= 100):
        return False
    mode = status.get('mode')
    if mode == 'emergency':
        return pwm >= 99.6
    return (mode == 'normal' and
            cfg['min_pwm_percent'] - 0.4 <= pwm <= cfg['max_pwm_percent'] + 0.4)


def describe(cfg):
    return (f"цель {cfg['target_c']} °C; PWM "
            f"{cfg['min_pwm_percent']}–{cfg['max_pwm_percent']}%")


def show(control):
    cfg = control.load_config(CONFIG_PATH)
    status = read_status()
    state, pid = service_info()
    active_status = state == 'active' and status.get('controller_pid') == pid and pid > 0
    print(f'Сохранено: {describe(cfg)}')
    print(f'Служба: {state}')
    try:
        applied = control.validate_config(status.get('applied_config'))
    except (ValueError, TypeError, RecursionError):
        applied = None
    if applied is not None:
        current = active_status and confirms(status, applied, control.config_hash(applied))
        print(f"{'Применено' if current else 'Последнее применённое'}: {describe(applied)}")
        if current:
            print(f"PWM сейчас: {status.get('pwm_actual_percent')}%; "
                  f"горячая GPU: {status.get('hottest_c')} °C; режим: {status.get('mode')}")
    if not active_status or not confirms(status, cfg, control.config_hash(cfg)):
        print('Применение сохранённых настроек пока не подтверждено.')
    if status.get('error'):
        print(f"Последняя ошибка: {status['error']}")
    return 0


def prompt_values(cfg):
    labels = ('Целевая температура, °C', 'Минимальный PWM, %', 'Максимальный PWM, %')
    values = []
    for key, label in zip(FIELDS, labels):
        raw = input(f'{label} [{cfg[key]}]: ').strip()
        values.append(cfg[key] if not raw else integer(raw))
    return values


def integer(raw):
    if not raw.isascii() or not raw.isdecimal():
        raise ValueError('Введите целое положительное число без единиц измерения.')
    return int(raw)


def candidate_config(control, cfg, values):
    target, minimum, maximum = values
    if not 20 <= target <= 70:
        raise ValueError('Целевая температура должна быть от 20 до 70 °C.')
    if not 30 <= minimum < maximum <= 100:
        raise ValueError('PWM: 30 ≤ минимум < максимум ≤ 100%.')
    candidate = dict(cfg, **dict(zip(FIELDS, values)))
    candidate['recovery_c'] = max(70, candidate['target_c'] + 2)
    return control.validate_config(candidate)


def atomic_write(path, cfg):
    data = (json.dumps(cfg, ensure_ascii=False, indent=2, allow_nan=False) + '\n').encode()
    if len(data) > MAX_CONFIG_BYTES:
        raise ValueError('Файл настроек после сохранения превысит 64 КиБ.')
    descriptor, name = tempfile.mkstemp(prefix=f'.{path.name}.', dir=path.parent)
    temporary = Path(name)
    try:
        with os.fdopen(descriptor, 'wb') as stream:
            os.fchmod(stream.fileno(), 0o644)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        temporary.unlink(missing_ok=True)


def wait_applied(control, cfg):
    digest = control.config_hash(cfg)
    deadline = time.monotonic() + ACK_TIMEOUT
    while (remaining := deadline - time.monotonic()) > 0:
        status = read_status()
        if confirms(status, cfg, digest):
            state, pid = service_info(timeout=min(3, remaining))
            if state == 'active' and status.get('controller_pid') == pid and pid > 0 and fresh(status):
                return status
        time.sleep(min(0.25, remaining))
    return None


def main(argv=None):
    parser = argparse.ArgumentParser(
        description='fanset: цель °C, минимальный PWM %, максимальный PWM %',
        epilog='Пример: fanset 65 30 100. Без аргументов — пошаговый ввод.')
    parser.add_argument('values', nargs='*', metavar='ЧИСЛО')
    parser.add_argument('--show', action='store_true', help='Показать настройки и состояние службы')
    args = parser.parse_args(argv)
    if args.show and args.values:
        parser.error('--show нельзя сочетать с настройкой значений')
    if len(args.values) not in (0, 3):
        parser.error('Нужны три числа: fanset 65 30 100')
    try:
        control = load_control()
        if args.show:
            return show(control)
        if os.geteuid() != 0:
            raise ValueError('Для изменения настроек запустите fanset через sudo или HiveShell.')
        cfg = control.load_config(CONFIG_PATH)
        values = ([integer(value) for value in args.values] if args.values else prompt_values(cfg))
        candidate = candidate_config(control, cfg, values)
        if not args.values:
            print(f'Новые настройки: {describe(candidate)}')
            if input('Применить? [д/Н]: ').strip().lower() not in ('д', 'да', 'y', 'yes'):
                print('Отменено. Настройки не изменены.')
                return 0
        lock_path = CONFIG_PATH.with_name('.cryptone-fan-control.lock')
        with lock_path.open('a') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise ValueError('Другая команда fanset уже работает. Повторите после её завершения.') from None
            latest = control.load_config(CONFIG_PATH)
            if latest != cfg:
                raise ValueError('Настройки изменились во время ввода. Повторите fanset.')
            atomic_write(CONFIG_PATH, candidate)
            print(f'Сохранено: {describe(candidate)}', flush=True)
            status = wait_applied(control, candidate)
            if status is None:
                print('Настройки сохранены, но применение не подтверждено. Проверьте fanset --show.',
                      file=sys.stderr)
                return 2
            print(f"Применено. PWM сейчас: {status['pwm_actual_percent']}%; режим: {status['mode']}.")
            if status.get('mode') == 'emergency':
                print('Действует аварийное охлаждение 100% независимо от обычного максимума.')
            return 0
    except (KeyboardInterrupt, EOFError):
        print('\nfanset прерван. Если уже выведено «Сохранено», проверьте fanset --show.', file=sys.stderr)
        return 130
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'fanset: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())

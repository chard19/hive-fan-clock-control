[Unit]
Description=Cryptone case fans from the hottest NVIDIA GPU
After=systemd-modules-load.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 /usr/local/sbin/cryptone-fan-control.py
ExecStopPost=/usr/bin/python3 /usr/local/sbin/cryptone-fan-control.py --failsafe
Restart=on-failure
RestartSec=3
WatchdogSec=30
WatchdogSignal=SIGKILL
TimeoutStartSec=20
TimeoutStopSec=10
RuntimeDirectory=cryptone-fan-control
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
